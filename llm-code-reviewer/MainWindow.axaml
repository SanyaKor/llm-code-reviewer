<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LLMCodeReviewer"
        x:Class="LLMCodeReviewer.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="llm-code-reviewer"
        Width="500"
        Height="240"
        MinWidth="500"
        MinHeight="240"
        Background="#2b2d30">
    
    
    
    <Grid ColumnDefinitions="*, *, *, 0.5*" RowDefinitions="Auto, 8*, 3*" Margin="16 0 16 0">
            

                
                
                <ComboBox Grid.Column="0"
                          Grid.Row="0"
                          x:Name="Other"
                          VerticalAlignment="Top"
                          HorizontalAlignment="Stretch"
                          SelectedIndex="0"
                          Margin="0,16,0,0">
                    <ComboBoxItem Content="Option 1"/>
                    <ComboBoxItem Content="Option 2"/>
                    <ComboBoxItem Content="Option 3"/>
                    <ComboBoxItem Content="Option 4"/>
                </ComboBox>    
                

                
                <Label Grid.Column="1"
                       Grid.Row="0"
                       Content="Prompt:"
                       FontSize="16"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Margin="0,16,8,0"/>

                
                <ComboBox Grid.Column="2"
                          Grid.Row="0"
                          x:Name="MyDropBox"
                          VerticalAlignment="Top"
                          HorizontalAlignment="Stretch"
                          SelectedIndex="0"
                          Margin="0,16,0,0">
                    <ComboBoxItem Content="Option 1"/>
                    <ComboBoxItem Content="Option 2"/>
                    <ComboBoxItem Content="Option 3"/>
                    <ComboBoxItem Content="Option 4"/>
                </ComboBox>    
            
            
                <Border Grid.Column="0"
                        Grid.Row="1"
                        Grid.ColumnSpan="4"
                        Background="#191A1D"
                        BorderBrush="#3C3F41"
                        BorderThickness="1"
                        Margin="0,8,0,8"
                        CornerRadius="4">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="MessagesPanel"
                                    Margin="8"
                                    Spacing="8"
                                    VerticalAlignment="Top"/>
                    </ScrollViewer>
                </Border>

                <TextBox Grid.Column="0"
                         Grid.Row="2"
                         Grid.ColumnSpan="4"
                         x:Name="InputBox"
                         AcceptsReturn="False"
                         TextWrapping="Wrap"
                         FontSize="16"
                         Watermark="Нижний TextBox (RowSpan=1)"
                         Margin="0,0,0,16"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch"
                         KeyDown="OnInputKeyDown"/>
        </Grid>
</Window>

